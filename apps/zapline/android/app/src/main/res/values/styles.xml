<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts: the brand ground and mark, never a
         white flash (Zapline is dark in both system modes). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI while it starts and runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- The mark stays on screen until Flutter draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
